<mvc:View
    controllerName="dashboard.controller.ManageDocuments"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Page id="pageManageDocuments" title="{i18n>pageManageDocuments}">
        <content>
            <VBox id="containerMainManageDocs" class="sapUiSmallMargin">
                <VBox id="containerManagedDocsFiles">
                    <Label id="lblManagedDocsListFiles" text="{i18n>lblListFiles}" />

                    <Table 
                        id="tableManageDocsFiles"
                        items='{
                            path: "remotedata>/Sheets",
                            sorter: [
                                {
                                    path: "dateUploaded",
                                    descending: true
                                },
                                {
                                    path: "timestamp",
                                    descending: true
                                }
                            ]
                        }'
                        mode="MultiSelect"
                    >
                        <headerToolbar>
                            <Toolbar id="toolbarMDF">
                                <ToolbarSpacer id="tbsMDF" />
                                <Button id="btnUploadFile" icon="sap-icon://upload" press=".openDialogUploadFile" />
                                <Button id="btnDeleteMDF" icon="sap-icon://delete" type="Reject" press=".deleteFiles" />
                                <SearchField id="sFieldMDF" placeholder="{i18n>searchField}" liveChange=".searchTableMDF" width="25%" />
                            </Toolbar>
                        </headerToolbar>
                        <columns>
                            <Column id="colMDFName">
                                <Text id="txtMDFName" text="{i18n>txtMDFName}" />
                            </Column>
                            <Column id="colMDFCategory">
                                <Text id="txtMDFCategory" text="{i18n>txtMDFCategory}" />
                            </Column>
                            <Column id="colMDFDateRange">
                                <Text id="txtMDFDateRange" text="{i18n>txtMDFDateRange}" />
                            </Column>
                            <Column id="colMDFUploadedBy">
                                <Text id="txtMDFUploadedBy" text="{i18n>txtMDFUploadedBy}" />
                            </Column>
                            <Column id="colMDFDateUploaded">
                                <Text id="txtMDFDateUploaded" text="{i18n>txtMDFDateUploaded}" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem
                                id="itemsMangeDocsFiles"
                                type="Active"
                            >
                                <cells>
                                    <Text id="txtItemName" text="{remotedata>name}" />
                                    <Text id="txtItemCategory" text="{remotedata>category}" />
                                    <Text id="txtItemDateRange" text="{remotedata>dateRange}" />
                                    <Text id="txtItemUploadedBy" text="{remotedata>uploadedBy}" />
                                    <Text id="txtItemDateUploaded" text="{remotedata>dateUploaded}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>