<mvc:View
    controllerName="dashboard.controller.Dashboard"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns:viz="sap.viz.ui5.controls"
>
    <Page
        id="pageDashboard"
    >
        <content>
            <VBox id="containerMainDashboard" class="sapUiSmallMargin">
                <HBox id="containerSSPDashboardAggregations" class="sapUiSmallMarginEnd" justifyContent="SpaceBetween">
                    <VBox 
                        id="containerSSPDashboardTiles"
                    >
                        <HBox id="containerSSPDataset">
                            <GenericTile id="gTileSSPSelectedDataset" header="{i18n>gTileSelectedDatasetHeader}" class="sapUiTinyMargin" frameType="TwoByHalf" press=".openDialogSelectDataset" >
                                <TileContent id="gTileSSPContentSelectedDataset">
                                    <Text id="txtSSPSelectedDataset" text="{SSPDashboardTilesModel>/fileSource}" />
                                </TileContent>
                            </GenericTile>
                            <GenericTile id="gTileSSPDateRange" pressEnabled="false" header="{i18n>gTileDateRangeHeader}" class="sapUiTinyMargin" frameType="TwoByHalf" >
                                <TileContent id="gTileSSPContentDateRange">
                                    <Text id="txtSSPDateRange" text="{SSPDashboardTilesModel>/dateRange}" />
                                </TileContent>
                            </GenericTile>
                        </HBox>
                        <HBox id="containerSSPTiles" class="sapUiLargeMarginTop" >
                            <GenericTile id="gTileSSPTotalRITMs" pressEnabled="false" header="{i18n>gTileTotalRITMsHeader}" subheader="{i18n>gTileTotalRITMsSubHeader}" class="sapUiTinyMargin" >
                                <TileContent id="gTileSSPContentTotalRITMs" unit="{i18n>unitTotalRITMs}">
                                    <NumericContent id="nContentSSPTotalRITMs" value="{SSPDashboardTilesModel>/totalRITMs}" icon="sap-icon://collections-management" />
                                </TileContent>
                            </GenericTile>

                            <GenericTile id="gTileSSPUniqueCreators" pressEnabled="false" header="{i18n>gTileUniqueCreatorsHeader}" subheader="{i18n>gTileUniqueCreatorsSubHeader}" class="sapUiTinyMargin" >
                                <TileContent id="gTileSSPContentUniqueCreators" unit="{i18n>unitUniqueCreators}">
                                    <NumericContent id="nContentSSPUniqueCreators" value="{SSPDashboardTilesModel>/uniqueCreators}" icon="sap-icon://activity-individual" />
                                </TileContent>
                            </GenericTile>

                            <GenericTile id="gTileSSPAvgRITMsPerDay" pressEnabled="false" header="{i18n>gTileAvgRITMsPerDayHeader}" subheader="{i18n>gTileAvgRITMsPerDaySubHeader}" class="sapUiTinyMargin" >
                                <TileContent id="gTileSSPContentAvgRITMsPerDay" unit="{i18n>unitAvgRITMsPerDay}">
                                    <NumericContent id="nContentSSPAvgRITMsPerDay" value="{SSPDashboardTilesModel>/avgRITMsPerDay}" icon="sap-icon://line-charts" />
                                </TileContent>
                            </GenericTile>
                        </HBox>
                    </VBox>
                    <HBox id="topSSPDashboardData" class="sapUiSmallMarginEnd">
                        <List 
                            id="listSSPTopCreators"
                            items="{SSPDashboardTilesModel>/topCreators}"
                            headerText="{i18n>listTopCreatorsHeaderTxt}"
                        >
                            <items>
                                <CustomListItem id="itemSSPTopCreators">
                                    <Text id="txtSSPTopCreators" text="{SSPDashboardTilesModel>creator} ({SSPDashboardTilesModel>totalRITMs})" class="sapUiTinyMargin" />
                                </CustomListItem>
                            </items>
                        </List>

                        <List 
                            id="listSSPBusiestDays"
                            items="{SSPDashboardTilesModel>/busiestDays}"
                            headerText="{i18n>listBusiestDaysHeaderTxt}"
                            class="sapUiMediumMarginBegin"
                        >
                            <items>
                                <CustomListItem id="itemSSPBusiestDays">
                                    <Text id="txtSSPBusiestDays" text="{SSPDashboardTilesModel>date} ({SSPDashboardTilesModel>totalRITMs})" class="sapUiTinyMargin" />
                                </CustomListItem>
                            </items>
                        </List>
                    </HBox>
                </HBox>
                <HBox id="containerOLTPDashboardAggregations" class="sapUiSmallMarginEnd" justifyContent="SpaceBetween">
                    <VBox 
                        id="containerOLTPDashboardTiles"
                    >
                        <HBox id="containerOLTPDataset">
                            <GenericTile id="gTileOLTPSelectedDataset" header="{i18n>gTileSelectedDatasetHeader}" class="sapUiTinyMargin" frameType="TwoByHalf" press=".openDialogSelectDataset" >
                                <TileContent id="gTileOLTPContentSelectedDataset">
                                    <Text id="txtOLTPSelectedDataset" text="{OLTPDashboardTilesModel>/fileSource}" />
                                </TileContent>
                            </GenericTile>
                            <GenericTile id="gTileOLTPDateRange" pressEnabled="false" header="{i18n>gTileDateRangeHeader}" class="sapUiTinyMargin" frameType="TwoByHalf" >
                                <TileContent id="gTileOLTPContentDateRange">
                                    <Text id="txtOLTPDateRange" text="{OLTPDashboardTilesModel>/dateRange}" />
                                </TileContent>
                            </GenericTile>
                        </HBox>
                        <HBox id="containerOLTPTiles" class="sapUiLargeMarginTop" >
                            <GenericTile id="gTileOLTPTotalRITMs" pressEnabled="false" header="{i18n>gTileTotalRITMsHeader}" subheader="{i18n>gTileTotalRITMsSubHeader}" class="sapUiTinyMargin" >
                                <TileContent id="gTileOLTPContentTotalRITMs" unit="{i18n>unitTotalRITMs}">
                                    <NumericContent id="nContentOLTPTotalRITMs" value="{OLTPDashboardTilesModel>/totalRITMs}" icon="sap-icon://collections-management" />
                                </TileContent>
                            </GenericTile>

                            <GenericTile id="gTileOLTPUniqueCreators" pressEnabled="false" header="{i18n>gTileUniqueCreatorsHeader}" subheader="{i18n>gTileUniqueCreatorsSubHeader}" class="sapUiTinyMargin" >
                                <TileContent id="gTileOLTPContentUniqueCreators" unit="{i18n>unitUniqueCreators}">
                                    <NumericContent id="nContentOLTPUniqueCreators" value="{OLTPDashboardTilesModel>/uniqueCreators}" icon="sap-icon://activity-individual" />
                                </TileContent>
                            </GenericTile>

                            <GenericTile id="gTileOLTPAvgRITMsPerDay" pressEnabled="false" header="{i18n>gTileAvgRITMsPerDayHeader}" subheader="{i18n>gTileAvgRITMsPerDaySubHeader}" class="sapUiTinyMargin" >
                                <TileContent id="gTileOLTPContentAvgRITMsPerDay" unit="{i18n>unitAvgRITMsPerDay}">
                                    <NumericContent id="nContentOLTPAvgRITMsPerDay" value="{OLTPDashboardTilesModel>/avgRITMsPerDay}" icon="sap-icon://line-charts" />
                                </TileContent>
                            </GenericTile>
                        </HBox>
                    </VBox>
                    <HBox id="topOLTPDashboardData" class="sapUiSmallMarginEnd">
                        <List 
                            id="listOLTPTopCreators"
                            items="{OLTPDashboardTilesModel>/topCreators}"
                            headerText="{i18n>listTopCreatorsHeaderTxt}"
                        >
                            <items>
                                <CustomListItem id="itemOLTPTopCreators">
                                    <Text id="txtOLTPTopCreators" text="{OLTPDashboardTilesModel>creator} ({OLTPDashboardTilesModel>totalRITMs})" class="sapUiTinyMargin" />
                                </CustomListItem>
                            </items>
                        </List>

                        <List 
                            id="listOLTPBusiestDays"
                            items="{OLTPDashboardTilesModel>/busiestDays}"
                            headerText="{i18n>listBusiestDaysHeaderTxt}"
                            class="sapUiMediumMarginBegin"
                        >
                            <items>
                                <CustomListItem id="itemOLTPBusiestDays">
                                    <Text id="txtOLTPBusiestDays" text="{OLTPDashboardTilesModel>date} ({OLTPDashboardTilesModel>totalRITMs})" class="sapUiTinyMargin" />
                                </CustomListItem>
                            </items>
                        </List>
                    </HBox>
                </HBox>
                <VBox id="containerDashboard" class="sapUiLargeMarginTop">
                    <viz:VizFrame
                        id="vizFrameTotalPerDate"
                        vizType="timeseries_line"
                        width="100%"
                    />
                    <HBox id="containerCreatorRITMs" class="sapUiLargeMarginTop">
                        <VBox id="containerVFTotalPerCreator" width="50%" class="sapUiLargeMarginEnd">
                            <viz:VizFrame
                                id="vizFrameTotalPerCreator"
                                vizType="bar"
                                width="100%"
                                selectData=".selectCreatorData"
                                class="sapUiLargeMarginTop"
                            />
                        </VBox>
                        <VBox id="containerVFDailyRITMsByCreator" width="50%" class="sapUiLargeMarginTop">
                            <Text
                                id="txtDislayCreatorRITMsTip"
                                text="{i18n>txtDislayCreatorRITMsTip}"
                                textAlign="Center"
                                width="100%"
                                visible="false"
                            />
                            <viz:VizFrame
                                id="vizFrameDailyRITMsByCreator"
                                vizType="column"
                                width="100%"
                            />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>