<mvc:View
    controllerName="dashboard.controller.Dashboard"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:viz="sap.viz.ui5.controls"
>
    <Page
        id="pageDashboard"
        title="{i18n>pageDashboardTitle}"
    >
        <content>
            <VBox id="containerMainOverview" class="sapUiSmallMargin">
                <f:Form id="formFileUpload">
                    <f:layout>
                        <f:ResponsiveGridLayout id="formFileUploadLayout" />
                    </f:layout>
                    <f:title>
                        <core:Title id="formFileUploadTitle" text="{i18n>formFileUploadTitle}" />
                    </f:title>
                    <f:formContainers>
                        <f:FormContainer id="formFileUploadContainer">
                            <f:formElements>
                                <f:FormElement id="formFileUploadTitleElement">
                                    <f:fields>
                                        <VBox id="containerFormFields">
                                            <HBox
                                                id="containerFormFileUploader"
                                                alignItems="Center"
                                            >
                                                <Label id="lblFileUploaderExcel" text="{i18n>lblFileUploaderExcel}" />
                                                <u:FileUploader
                                                    id="fileUploaderExcel"
                                                    class="sapUiSmallMarginBegin"
                                                    buttonOnly="true"
                                                    fileType="xlsx"
                                                    change="uploadFile"
                                                />
                                            </HBox>
                                        </VBox>
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>

                <VBox id="containerFiles" class="sapUiMediumMarginTop">
                    <Label id="lblListFiles" text="{i18n>lblListFiles}" />
                    <List
                        id="listFiles"
                        items="{remotedata>/Sheets}"
                    >
                        <items>
                            <CustomListItem
                                id="itemListFiles"
                                type="Active"
                                press=".triggerLoadDashboardDate"
                            >
                                <VBox
                                    id="containerItemListFiles"
                                    class="sapUiTinyMargin"
                                >
                                    <Text id="txtFileName" text="{remotedata>name}" />
                                </VBox>
                            </CustomListItem>
                        </items>
                    </List>
                </VBox>
                <VBox id="containerDashboard">
                    <HBox id="containerCreatorRITMs">
                        <VBox id="containerVFTotalPerCreator" width="50%">
                            <viz:VizFrame
                                id="vizFrameTotalPerCreator"
                                vizType="bar"
                                width="100%"
                                selectData=".selectCreatorData"
                                class="sapUiMediumMarginTop"
                            />
                        </VBox>
                        <VBox id="containerVFDailyRITMsByCreator" width="50%">
                            <Text
                                id="txtDislayCreatorRITMsTip"
                                text="{i18n>txtDislayCreatorRITMsTip}"
                                textAlign="Center"
                                width="100%"
                                class="sapUiMediumMarginTop"
                                visible="false"
                            />
                            <viz:VizFrame
                                id="vizFrameDailyRITMsByCreator"
                                vizType="column"
                                width="100%"
                            />
                        </VBox>
                    </HBox>

                    <viz:VizFrame
                        id="vizFrameTotalPerDate"
                        vizType="timeseries_line"
                        width="100%"
                        class="sapUiMediumMarginTop"
                    />
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>