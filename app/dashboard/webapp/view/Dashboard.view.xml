<mvc:View
    controllerName="dashboard.controller.Dashboard"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns:viz="sap.viz.ui5.controls"
>
    <Page
        id="pageDashboard"
        title="{i18n>pageDashboardTitle}"
    >
        <content>
            <VBox id="containerMainDashboard" class="sapUiSmallMargin">
                <Button id="testt" text="test" press=".openDialogSelectDataset" />
                <VBox id="containerDashboard">
                    <viz:VizFrame
                        id="vizFrameTotalPerDate"
                        vizType="timeseries_line"
                        width="100%"
                        class="sapUiMediumMarginTop"
                    />
                    <HBox id="containerCreatorRITMs">
                        <VBox id="containerVFTotalPerCreator" width="50%">
                            <viz:VizFrame
                                id="vizFrameTotalPerCreator"
                                vizType="bar"
                                width="100%"
                                selectData=".selectCreatorData"
                                class="sapUiMediumMarginTop"
                            />
                        </VBox>
                        <VBox id="containerVFDailyRITMsByCreator" width="50%">
                            <Text
                                id="txtDislayCreatorRITMsTip"
                                text="{i18n>txtDislayCreatorRITMsTip}"
                                textAlign="Center"
                                width="100%"
                                class="sapUiMediumMarginTop"
                                visible="false"
                            />
                            <viz:VizFrame
                                id="vizFrameDailyRITMsByCreator"
                                vizType="column"
                                width="100%"
                            />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>