<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
>
    <Dialog
        id="dialogUploadFile"
        title="{i18n>dialogUploadFileTitle}"
        escapeHandler=".dialogUploadFileEscapeHandler"
    >
        <content>
            <VBox 
                id="containerUploadFile"
                class="sapUiSmallMargin"
            >
                <Label id="lblComBoxFileCategory" labelFor="comBoxFileCategory" text="{i18n>lblComBoxFileCategory}" />
                <ComboBox
                    id="comBoxFileCategory"
                    items="{FileCategoryModel>/items}"
                    selectedKey="{FileCategoryModel>/selectedKey}"
                >
                    <core:Item id="itemComBoxFileCategory" key="{FileCategoryModel>key}" text="{FileCategoryModel>text}" />
                </ComboBox>

                <Label id="lblfileUploaderExcel" text="{i18n>lblfileUploaderExcel}" class="sapUiSmallMarginTop" />
                <HBox 
                    id="containerFileUploaderExcel"
                >
                    <u:FileUploader
                        id="fileUploaderExcel"
                        fileType="xlsx"
                        change=".processFile"
                        icon="sap-icon://add"
                        buttonOnly="true"
                    />
                    <Input id="inputSelectedFileName" class="sapUiTinyMarginBegin" editable="false" />
                </HBox>
            </VBox>
        </content>
        <beginButton>
            <Button id="btnSubmit" text="{i18n>btnSubmit}" type="Emphasized" press=".uploadFile" />
        </beginButton>
        <endButton>
            <Button id="btnCancel" text="{i18n>btnCancel}" type="Reject" press=".closeDialogUploadFile" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>